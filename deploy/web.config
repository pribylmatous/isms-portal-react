<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS konfigurace pro produkční build ISMS portálu (dist/) — nasadit do
  IIS site, jejíž root ukazuje na dist/ (obsahuje tento soubor + index.html).

  Frontend používá ruční hash routing (#/dashboard, #/incidents/...) — hash
  se prohlížečem na server nikdy neposílá, takže IIS vidí jen požadavky na
  "/" a na statické soubory. Není potřeba žádné URL rewrite pravidlo pro
  klientské cesty, jen pro proxy na API.

  Prerekvizity na serveru (nastavuje se mimo tento soubor):
  1. IIS moduly URL Rewrite a Application Request Routing (ARR) — obojí
     samostatné instalátory z Microsoft IIS Extensions.
  2. V IIS Manageru na úrovni serveru zapnout ARR proxy:
     Server → Application Request Routing Cache → Server Proxy Settings →
     zaškrtnout "Enable proxy". Bez toho rewrite pravidlo níže na backend
     nedosáhne (vrátí 502).
  3. isms-api běží jako samostatný proces na portu 3001 (např. přes
     iisnode, nebo jen jako běžící Node proces spravovaný process manažerem —
     IIS je tu jen reverse proxy, ne hostitel Node procesu).

  Cachování: soubory v assets/ mají ve jméně obsahový hash (vite build) —
  ty smí IIS cachovat agresivně/napořád (výchozí chování IIS je v pořádku).
  index.html hash v názvu nemá a musí se při každém nasazení znovu stáhnout,
  jinak by prohlížeč po deploy servíroval starou appku se starými odkazy na
  assety. Pokud bude potřeba vynutit no-cache jen pro index.html, přidej
  samostatný location path="index.html" blok s vlastním httpProtocol
  místo globálního pravidla (to by jinak zneplatnilo cache i pro assety).
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="ReverseProxyToApi" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3001/api/{R:1}" />
          <!-- Uprav 127.0.0.1:3001, pokud isms-api neběží na stejném serveru. -->
        </rule>
      </rules>
    </rewrite>
    <staticContent>
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>
  </system.webServer>
</configuration>

